# MoleCare MCP — example configuration
#
# Copy to .env and fill in only what you need. Every variable is OPTIONAL.
# The public server uses mock product data without API credentials, and the
# development default below keeps operations integrations in mock mode. This
# is the recommended setup for development and demos.
#
# NEVER point these at production and NEVER commit a filled-in .env.

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Optional HTTP health endpoint (GET /health), used by Docker/ECS probes.
# MCP_HEALTH_PORT takes precedence; PORT is the container-friendly fallback.
MCP_HEALTH_PORT=
PORT=3000
# Optional local sidecar that checks tool results before they leave the machine.
# Protected tool calls fail closed if a configured gate does not answer in time.
PRIVACY_GATE_URL=
PRIVACY_GATE_TIMEOUT_MS=4000

# ---- MoleCare API (optional) ------------------------------------------------
# Tools that accept a userId return PHI if you point them at a real backend.
# Treat any non-localhost value here as production data.
MOLECARE_API_URL=http://localhost:8080/api
MOLECARE_API_KEY=local-dev-key
BACKEND_URL=http://localhost:8080

# ---- App surfaces (optional) ------------------------------------------------
WEB_APP_URL=http://localhost:3000
MOBILE_API_URL=http://localhost:8080/api
ADMIN_API_URL=http://localhost:8080

# ---- MLOps (optional, mock when unset) --------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_API_KEY=
ML_SERVING_URL=http://localhost:5000/health
FEAST_SERVER_URL=http://localhost:6566
FEAST_PROJECT=molecare
METRICS_API_URL=

# ---- Datastores (optional, health checks only) ------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=molecare
REDIS_HOST=localhost:6379
ES_HOST=localhost:9200

# ---- AWS (optional) ---------------------------------------------------------
# Prefer an IAM role or a named local profile over static keys.
# Do not put a real AWS_SECRET_ACCESS_KEY in this file.
AWS_REGION=us-east-1
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
EC2_INSTANCE_IDS=

# ---- CI tooling (optional) --------------------------------------------------
GITHUB_OWNER=MoleCare
GITHUB_REPO=MoleCare-ML
GITHUB_TOKEN=
